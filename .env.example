# Token da API do Instagram (login unificado — começa com "EAA" e não expira).
# NÃO coloque esse valor no código: cadastre em Netlify > Site configuration > Environment variables.
# Para testar localmente com `npm run dev:netlify`, copie este arquivo para `.env` e preencha.
INSTAGRAM_TOKEN=

# Opcional: ID numérico da conta do Instagram. A function tenta descobrir sozinha;
# só preencha se /api/instagram pedir.
INSTAGRAM_USER_ID=
